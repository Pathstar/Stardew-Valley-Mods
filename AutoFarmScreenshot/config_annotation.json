{
  // General rule for all settings:
  // An empty string or 0 means "unlimited" / "no restriction".

  // Master control switch
  "enabled": true,

  // Cooldown between actual photos, in seconds.
  // This is shared by all trigger types and locations.
  "photoCooldown": 30,

  // If you don't know the name of a place, you can turn on this switch and enter the game to see
  "printLocationNameWhenEntering": false,
  
  // Triggered when the player enters one of the specified locations from another location.
  // Default Settings: Take photos when you first enter the farm each game day
  "locationEntryTrigger": {
    "enabled": true,

    // Separate multiple locations with commas.
    // Restrictions are calculated independently for each location.
    "locations": "Farm, IslandWest",

    // Cooldown between triggers, in seconds.
    "triggerCooldown": 60,

    // Allowed time ranges, e.g. "06:00-22:00".
    // Separate multiple time ranges with commas.
    "allowedTimeRanges": "",

    // Take a photo after this many qualifying triggers have occurred.
    "triggersBeforeTakingPhoto": 1,

    // Maximum number of photos that can be taken per in-game day.
    // 0 = unlimited.
    "dailyPhotoLimit": 1
  },

  // Triggered when a change occurs in a terrain feature list.
  // Default Settings: Take a photo when the region has changed more than 16 times
  "changeTrigger": {
    "enabled": true,

    // Separate multiple locations with commas.
    // Restrictions are calculated independently for each location.
    "locations": "Farm, IslandWest",

    // Cooldown between triggers, in seconds.
    "triggerCooldown": 1,

    // Allowed time ranges, e.g. "06:00-22:00".
    // Separate multiple time ranges with commas.
    "allowedTimeRanges": "",

    // Take a photo after this many qualifying triggers have occurred.
    "triggersBeforeTakingPhoto": 16,

    // Maximum number of photos that can be taken per in-game day.
    // 0 = unlimited.
    "dailyPhotoLimit": 0
  }
}